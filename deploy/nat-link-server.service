[Unit]
Description=NAT-Link self-hosted relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nat-link
Group=nat-link
WorkingDirectory=/opt/nat-link
ExecStart=/opt/nat-link/nat-link-server -config /opt/nat-link/config.yaml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nat-link/data /opt/nat-link/logs
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
