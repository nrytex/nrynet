<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nat-linkdesktop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\NAT-Link\NAT-Link">
    </Installer>
    <PackageInformation
        PackageName="NAT-Link"
        PackageDisplayName="NAT-Link"
        PublisherName="CN=NAT-Link"
        PublisherDisplayName="NAT-Link"
        Version="1.0.0.0"
        PackageDescription="NAT-Link desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="io.natlink.desktop"
                Description="NAT-Link desktop client"
                DisplayName="NAT-Link"
                ExecutableName="nat-linkdesktop.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NAT-Link</DisplayName>
            <PublisherDisplayName>NAT-Link</PublisherDisplayName>
            <Description>NAT-Link desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nat-linkdesktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
